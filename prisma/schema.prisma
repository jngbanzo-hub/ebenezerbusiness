generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WhatsAppNotificationRole {
  EXPEDITEUR
  BENEFICIAIRE
}

enum WhatsAppProvider {
  DIALOG360
  GREEN_API
  META_CLOUD
  DRY_RUN
}

enum WhatsAppNotificationState {
  DRY_RUN
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED_INVALID_RECIPIENT
}

model WhatsAppNotificationLog {
  id                    String                    @id @default(cuid())
  dedupKey              String                    @unique
  provider              WhatsAppProvider          @default(DRY_RUN)
  messageId             String?                   @unique
  sheetName             String
  rowNumber             Int
  codeColis             String
  templateName          String
  recipientRole         WhatsAppNotificationRole
  recipientName         String
  recipientNumberHash   String
  recipientNumberMasked String
  triggerStatus         String
  dateConcerned         String?
  whatsappStatus        WhatsAppNotificationState
  createdAt             DateTime                  @default(now())
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  failedAt              DateTime?
  error                 String?                   @db.Text
  errorCode             String?
  errorDescription      String?                   @db.Text
  lastWebhookAt         DateTime?

  @@index([sheetName, codeColis, templateName, recipientRole, recipientNumberHash])
  @@index([messageId])
}
