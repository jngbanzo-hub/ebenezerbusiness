# Production variables for Vercel.
# Copy these names into Vercel Project Settings > Environment Variables.
# Do not commit real secret values.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

NEXTAUTH_URL="https://ebenezerbusiness.com"
NEXTAUTH_SECRET="generate-a-strong-secret-with-openssl-rand-base64-32"

# Google Sheets tracking.
# Recommended on Vercel: use GOOGLE_SERVICE_ACCOUNT_JSON_BASE64.
# Leave GOOGLE_APPLICATION_CREDENTIALS empty in production because Vercel cannot read your local file path.
GOOGLE_SHEETS_SPREADSHEET_ID="18yTYaFFU4p44WRyppQv6c8BlrE1ldUmirDDfyC0avHs"
GOOGLE_SHEETS_MANIFEST_SPREADSHEET_ID="195v-sgYQfDt3nlE3nvhiNv6APvEPolDLO2JumaUo3To"
GOOGLE_SHEETS_TRACKING_TABS="FIH,LSHI,KLZ"
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64="base64-encoded-service-account-json"

# Supported fallback alternatives if you do not use GOOGLE_SERVICE_ACCOUNT_JSON_BASE64:
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# WhatsApp notifications.
WHATSAPP_PROVIDER="360dialog"
DIALOG360_API_KEY=
DIALOG360_BASE_URL="https://waba-v2.360dialog.io"
DIALOG360_COLIS_LIVRE_APPROVED="false"
DIALOG360_EN_VOL_APPROVED="false"
DIALOG360_EN_TRANSIT_APPROVED="false"
DIALOG360_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_TESTS_ENABLED="false"
NOTIFICATIONS_DRY_RUN="true"
NOTIFICATIONS_WRITE_SHEET_STATUS="false"
NOTIFICATIONS_SYNC_SECRET=
